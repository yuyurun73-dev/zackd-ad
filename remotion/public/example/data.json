 ],
 "captions": [
  {
   "text": "まわりの子が",
   "start": 0.18,
   "end": 0.7,
   "beat": "b01"
  },
  {
   "text": "どんどんパンツになって",
   "start": 0.7,
   "end": 1.88,
   "beat": "b01"
  },
  {
   "text": "焦っているママへ",
   "start": 1.88,
   "end": 2.99,
   "beat": "b01"
  },
  {
   "text": "遅れているのは",
   "start": 3.04,
   "end": 3.76,
   "beat": "b02"
  },
  {
   "text": "子どもでも",
   "start": 3.76,
   "end": 4.38,
   "beat": "b02"
  },
  {
   "text": "ママの育て方でもありません",
   "start": 4.38,
   "end": 6.03,
   "beat": "b02"
  },
  {
   "text": "公園で同い年の子が",
   "start": 6.08,
   "end": 7.46,
   "beat": "b03"
  },
  {
   "text": "「トイレ行ってくる」と",
   "start": 7.46,
   "end": 8.28,
   "beat": "b03"
  },
  {
   "text": "走っていく",
   "start": 8.28,
   "end": 9.01,
   "beat": "b03"
  },
  {
   "text": "ママ友からは",
   "start": 9.06,
   "end": 10.28,
   "beat": "b04"
  },
  {
   "text": "「オムツ卒業したよ」と",
   "start": 10.28,
   "end": 11.12,
   "beat": "b04"
  },
  {
   "text": "連絡が来る",
   "start": 11.12,
   "end": 12.09,
   "beat": "b04"
  },
  {
   "text": "園のお迎えに行くたびに",
   "start": 12.14,
   "end": 13.08,
   "beat": "b05"
  },
  {
   "text": "パンツの子が増えている",
   "start": 13.08,
   "end": 14.35,
   "beat": "b05"
  },
  {
   "text": "うちの子だけが",
   "start": 14.4,
   "end": 15.1,
   "beat": "b06a"
  },
  {
   "text": "まだオムツで",
   "start": 15.1,
   "end": 15.93,
   "beat": "b06a"
  },
  {
   "text": "「おしっこでた？」と聞いても",
   "start": 15.98,
   "end": 17.4,
   "beat": "b06b"
  },
  {
   "text": "「でてない」と言う",
   "start": 17.4,
   "end": 18.15,
   "beat": "b06b"
  },
  {
   "text": "帰り道ずっと",
   "start": 18.2,
   "end": 19.18,
   "beat": "b07"
  },
  {
   "text": "「なんでうちだけ」と",
   "start": 19.18,
   "end": 20.38,
   "beat": "b07"
  },
  {
   "text": "考えてしまう",
   "start": 20.38,
   "end": 21.169999999999998,
   "beat": "b07"
  },
  {
   "text": "でも先に外れた子と",
   "start": 21.22,
   "end": 22.34,
   "beat": "b08"
  },
  {
   "text": "違うのは",
   "start": 22.34,
   "end": 23.16,
   "beat": "b08"
  },
  {
   "text": "はかせている物かもしれません",
   "start": 23.16,
   "end": 24.29,
   "beat": "b08"
  },
  {
   "text": "今の紙オムツは",
   "start": 24.34,
   "end": 25.68,
   "beat": "b09a"
  },
  {
   "text": "出た瞬間に",
   "start": 25.68,
   "end": 26.34,
   "beat": "b09a"
  },
  {
   "text": "全部吸いこんで",
   "start": 26.34,
   "end": 27.11,
   "beat": "b09a"
  },
  {
   "text": "肌をサラサラに戻すので",
   "start": 27.16,
   "end": 28.73,
   "beat": "b09b"
  },
  {
   "text": "子どもは",
   "start": 28.78,
   "end": 29.14,
   "beat": "b09c"
  },
  {
   "text": "出たことに気づけません",
   "start": 29.14,
   "end": 30.29,
   "beat": "b09c"
  },
  {
   "text": "先に外れた子の家が",
   "start": 30.34,
   "end": 31.44,
   "beat": "b10"
  },
  {
   "text": "やっていたのは",
   "start": 31.44,
   "end": 32.22,
   "beat": "b10"
  },
  {
   "text": "薄いパンツで",
   "start": 32.22,
   "end": 32.94,
   "beat": "b10"
  },
  {
   "text": "気づかせることです",
   "start": 32.94,
   "end": 33.99,
   "beat": "b10"
  },
  {
   "text": "ただ普通のパンツだと",
   "start": 34.04,
   "end": 35.18,
   "beat": "b11"
  },
  {
   "text": "全部が床まで落ちて",
   "start": 35.18,
   "end": 36.62,
   "beat": "b11"
  },
  {
   "text": "今度は怒ってしまう",
   "start": 36.62,
   "end": 37.63,
   "beat": "b11"
  },
  {
   "text": "そこで",
   "start": 37.68,
   "end": 38.18,
   "beat": "b12a"
  },
  {
   "text": "トイトレ中のママたちが",
   "start": 38.18,
   "end": 39.22,
   "beat": "b12a"
  },
  {
   "text": "選んでいるのが",
   "start": 39.22,
   "end": 40.03,
   "beat": "b12a"
  },
  {
   "text": "このおひさまパンツです",
   "start": 40.08,
   "end": 41.27,
   "beat": "b12b"
  },
  {
   "text": "内側の綿が",
   "start": 41.32,
   "end": 42.22,
   "beat": "b13a"
  },
  {
   "text": "ぬれた感覚を",
   "start": 42.22,
   "end": 42.86,
   "beat": "b13a"
  },
  {
   "text": "肌に残して",
   "start": 42.86,
   "end": 43.93,
   "beat": "b13a"
  },
  {
   "text": "まんなかの吸水布と",
   "start": 43.98,
   "end": 44.9,
   "beat": "b13b"
  },
  {
   "text": "外の層が",
   "start": 44.9,
   "end": 45.64,
   "beat": "b13b"
  },
  {
   "text": "少しのもれを",
   "start": 45.64,
   "end": 46.36,
   "beat": "b13b"
  },
  {
   "text": "中でとめます",
   "start": 46.36,
   "end": 47.370000000000005,
   "beat": "b13b"
  },
  {
   "text": "ぬれたと気づいた子は",
   "start": 47.42,
   "end": 48.5,
   "beat": "b14"
  },
  {
   "text": "自分から",
   "start": 48.5,
   "end": 49.16,
   "beat": "b14"
  },
  {
   "text": "「でた」と",
   "start": 49.16,
   "end": 49.5,
   "beat": "b14"
  },
  {
   "text": "言いに来るようになります",
   "start": 49.5,
   "end": 50.35,
   "beat": "b14"
  },
  {
   "text": "このまま春になると",
   "start": 50.4,
   "end": 51.72,
   "beat": "b15"
  },
  {
   "text": "入園式で",
   "start": 51.72,
   "end": 52.36,
   "beat": "b15"
  },
  {
   "text": "うちの子だけ",
   "start": 52.36,
   "end": 53.08,
   "beat": "b15"
  },
  {
   "text": "紙パンツということに",
   "start": 53.08,
   "end": 54.21,
   "beat": "b15"
  },
  {
   "text": "なるかもしれません",
   "start": 54.21,
   "end": 55.150000000000006,
   "beat": "b15"
  },
  {
   "text": "サイズが合わなければ",
   "start": 55.2,
   "end": 56.26,
   "beat": "b16"
  },
  {
   "text": "届いてから",
   "start": 56.26,
   "end": 57.02,
   "beat": "b16"
  },
  {
   "text": "三十日以内なら",
   "start": 57.02,
   "end": 57.66,
   "beat": "b16"
  },
  {
   "text": "交換できます",
   "start": 57.66,
   "end": 58.510000000000005,
   "beat": "b16"
  },
  {
   "text": "ただ入園準備の時期で",
   "start": 58.56,
   "end": 59.84,
   "beat": "b17a"
  },
  {
   "text": "注文が重なっていて",
   "start": 59.84,
   "end": 61.11,
   "beat": "b17a"
  },
  {
   "text": "柄とサイズによっては",
   "start": 61.16,
   "end": 62.18,
   "beat": "b17b"
  },
  {
   "text": "在庫が残りわずかです",
   "start": 62.18,
   "end": 63.57,
   "beat": "b17b"
  },
  {
   "text": "来月も",
   "start": 63.62,
   "end": 64.32,
   "beat": "b18a"
  },
  {
   "text": "「なんでうちだけ」と",
   "start": 64.32,
   "end": 65.23,
   "beat": "b18a"
  },
  {
   "text": "思い続けるか",
   "start": 65.23,
   "end": 66.19,
   "beat": "b18a"
  },
  {
   "text": "今日はかせる物を",
   "start": 66.24,
   "end": 67.34,
   "beat": "b18b"
  },
  {
   "text": "一枚変えるか",
   "start": 67.34,
   "end": 68.05,
   "beat": "b18b"
  },
  {
   "text": "在庫があるうちに",
   "start": 68.1,
   "end": 69.04,
   "beat": "b19"
  },
  {
   "text": "下のボタンから",
   "start": 69.04,
   "end": 69.74,
   "beat": "b19"
  },
  {
   "text": "おひさまパンツを",
   "start": 69.74,
   "end": 70.56,
   "beat": "b19"
  },
  {
   "text": "確かめてください",
   "start": 70.56,
   "end": 71.456757,
   "beat": "b19"
  }
 ]
}